@model CreateBannerDto
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<form method="post">
    <label>Görsel Url</label>
    <input type="text" asp-for="ImageUrl" class="form-control"/>
    <span class="text-danger" asp-validation-for="ImageUrl"></span>
    <br />
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control" />
    <span class="text-danger" asp-validation-for="Title"></span>
    <br />
    <label>Açıklama</label>
    <input type="text" asp-for="Desc" class="form-control" />
    <span class="text-danger" asp-validation-for="Desc"></span>
    <br />
    <button class="btn btn-outline-danger">Kaydet</button>
</form>

