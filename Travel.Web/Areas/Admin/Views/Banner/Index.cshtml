@model List<ResultBannerDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Banner Alanı</h1>

<table class="table table-bordered table-hover">
    @{
        int count = 0;
    }
    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td><img src="@item.ImageUrl" style="height:75px;width:75px" alt="@item.Title" /></td>
            <td>@item.Title</td>
            <td>@(item.Desc.Length > 50 ? item.Desc.Substring(0, 50) + "..." : item.Desc)</td>
            <td>
                <a href="#" class="btn btn-outline-danger">Sil</a>
                <a href="#" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<a href="/Admin/Banner/Create" class="btn btn-outline-dark">Yeni Banner Alanı Ekle</a>
